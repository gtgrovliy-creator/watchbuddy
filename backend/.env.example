# YouTube API Key - get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Server port
PORT=5000

# Telegram Bot Token - get one from @BotFather
# Leave as is to disable the bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Public URL of your app (for Telegram bot links)
# Example: https://watchbuddy.onrender.com
PUBLIC_URL=http://localhost:5000